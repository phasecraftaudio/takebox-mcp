{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../shared/**/*.ts", "../server/takeTools.ts"]
}
