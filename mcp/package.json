{
  "name": "@phasecraftaudio/takebox-mcp",
  "version": "0.1.0",
  "description": "TAKEBOX as an MCP server: sound for your game, planned, generated, trimmed, levelled and named so your AI can wire it in.",
  "license": "Apache-2.0",
  "author": "PHASECRAFT (https://phasecraftaudio.com)",
  "homepage": "https://github.com/phasecraftaudio/takebox-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phasecraftaudio/takebox-mcp.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/phasecraftaudio/takebox-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "game-audio",
    "sound-effects",
    "sfx",
    "elevenlabs",
    "godot",
    "unity",
    "phaser",
    "audio"
  ],
  "type": "module",
  "bin": {
    "takebox-mcp": "dist/takebox-mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@wasm-audio-decoders/flac": "0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "mpg123-decoder": "1.0.3",
    "ogg-opus-decoder": "1.7.5",
    "wasm-media-encoders": "0.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
